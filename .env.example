# Portable loopback development PostgreSQL; no password or real secrets.
DATABASE_URL=postgresql+psycopg://astrasynq@127.0.0.1:55432/astrasynq
TEST_DATABASE_URL=postgresql+psycopg://astrasynq@127.0.0.1:55432/astrasynq_test
# For an existing PostgreSQL service, replace DATABASE_URL with its connection URL.
# Compose requires a locally supplied password; never commit it.
POSTGRES_USER=astrasynq
POSTGRES_DB=astrasynq
POSTGRES_PASSWORD=
ASTRASYNQ_API_URL=http://127.0.0.1:8011
# Local HTTP only. Production requires HTTPS and true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_HOURS=12
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:4184,http://localhost:4184,http://127.0.0.1:8011
# Bootstrap prompts for email/password; never store a real password in this file.
# ASTRASYNQ_WORKSPACE_ID=<existing workspace UUID, required if multiple exist>

# Development settings. Outbound still forbids HTTP/private addresses unless explicitly opted in.
# Production: mode=production, Secure=true, explicit HTTPS origins, strong DB password.
# Remote production PostgreSQL requires sslmode=verify-full. See docs/SECURITY.md.
ASTRASYNQ_MODE=development
ASTRASYNQ_ALLOW_PRIVATE_WEBHOOKS=false
# Configure only references in the UI: ASTRASYNQ_CREDENTIAL_WEBHOOK / TELEGRAM.
# Supply their values privately to worker env; do not commit or paste into logs.
# ASTRASYNQ_CREDENTIAL_WEBHOOK=
# ASTRASYNQ_CREDENTIAL_TELEGRAM=

