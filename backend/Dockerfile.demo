FROM node:24-alpine AS frontend
WORKDIR /ui
RUN npm install -g pnpm@11.25.0
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
ENV VITE_ASTRASYNQ_DEMO_MODE=true
RUN pnpm build

FROM python:3.12-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# psycopg[binary] bundles OpenSSL; point its system trust lookup at Debian's CA bundle.
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app
COPY backend/samples ./samples
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./
COPY --from=frontend /ui/dist/client /app/demo-static
ENV ASTRASYNQ_DEMO_STATIC_DIR=/app/demo-static
RUN useradd --system --uid 10001 appuser
USER appuser
EXPOSE 8000
CMD ["python", "-m", "app.demo_start"]
